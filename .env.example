# Base URL of the StampOrders C# API.
#
# Use the HTTP profile rather than HTTPS in development: the API's dev certificate is
# self-signed and the Next.js server-side proxy will reject it.
#
# From src/StampOrders.Api/Properties/launchSettings.json:
#   https://localhost:57900;http://localhost:57901
STAMP_ORDERS_API_URL=http://localhost:57901
